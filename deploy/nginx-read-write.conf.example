# Voorbeeld: publiceer de webapp, read-API en AI-API, maar sta de write-API alleen toe vanuit het LAN.
# Pas magic-collection:3000 en de LAN-subnetten aan jouw omgeving aan.

upstream magic_collection_backend {
    server magic-collection-manager:3000;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name magic.example.nl;

    # Voeg hier je eigen ssl_certificate- en ssl_certificate_key-regels toe.

    # Deze regex dekt zowel /api/write als alles onder /api/write/.
    location ~ ^/api/write(?:/|$) {
        allow 127.0.0.1;
        allow ::1;
        allow 192.168.0.0/16;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow fd00::/8;
        deny all;

        proxy_pass http://magic_collection_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Statische webapp, /api/read en /api/ai zijn via deze algemene route bereikbaar.
    location / {
        proxy_pass http://magic_collection_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
